# 复制为 .env.local 后填写（.env.local 不会提交到 Git）

# 后端：mock（演示数据）| rag（公司 RAG 平台，待实现）| dify
CHAT_BACKEND=mock

# 团队口令：留空则不校验（仅限本机开发）
ACCESS_CODE=
# Cookie 签名密钥：随便填一串足够长的随机字符
SESSION_SECRET=
# 能进入管理后台的姓名，用英文逗号分隔；留空则所有人都能进
ADMIN_USERS=

# ---- Plan A：公司 RAG 平台（拿到 API 文档后填写）----
RAG_API_URL=
RAG_API_KEY=
RAG_AGENT_ID=
# 只用提示词的智能体，用于生成推荐追问 / 意图识别
RAG_SUGGEST_AGENT_ID=

# ---- Plan B：Dify ----
# 例如 https://dify.example.com/v1
DIFY_API_URL=
DIFY_API_KEY=
